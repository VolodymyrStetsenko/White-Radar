# Copy this file to .env. Never commit the real .env file.

# One HTTP endpoint per enabled chain. Use provider dashboard URLs verbatim.
RPC_ETHEREUM_HTTP=
RPC_ETHEREUM_WS=
RPC_BASE_HTTP=
RPC_BASE_WS=
RPC_ARBITRUM_HTTP=
RPC_ARBITRUM_WS=
RPC_OPTIMISM_HTTP=
RPC_OPTIMISM_WS=
RPC_POLYGON_HTTP=
RPC_POLYGON_WS=
RPC_SEPOLIA_HTTP=
RPC_SEPOLIA_WS=

# Etherscan API V2 uses one key with the chainid parameter for supported chains.
ETHERSCAN_API_KEY=

# Optional. Keep disabled until a private chat/channel has been configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operational overrides.
WHITE_RADAR_CONFIG=config.toml
WHITE_RADAR_WATCHLIST=watchlist.toml
WHITE_RADAR_DB=data/white-radar.sqlite3
WHITE_RADAR_DRY_RUN=true
